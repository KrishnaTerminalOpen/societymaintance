# ==============================================================================
# ColonyDeposit - Environment Configuration Template
# All financial values must be stored in paise (integer) in business logic.
# Never commit real credentials to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
APP_PORT=3000
API_PORT=4000

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL with Connection Pooling)
# ------------------------------------------------------------------------------
# DATABASE_URL: Connection pooled URL (e.g., PgBouncer, Prisma Accelerate, port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colonydeposit?schema=public&connection_limit=20"
# DIRECT_URL: Direct unpooled connection URL used strictly for Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/colonydeposit?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHE & BACKGROUND QUEUES (Redis + BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & TOKENS (OTP + JWT + RBAC)
# ------------------------------------------------------------------------------
# Secrets must be cryptographically secure 256-bit strings (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET="change-this-to-a-secure-random-access-secret-32-chars-min"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-refresh-secret-32-chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Primary OTP Provider: MSG91
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="COLONY"
MSG91_TEMPLATE_ID=""
MSG91_OTP_EXPIRY_MINUTES=5

# Fallback OTP Provider: Twilio (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# ------------------------------------------------------------------------------
# 5. STORAGE (Cloudflare R2 / S3 Compatible)
# ------------------------------------------------------------------------------
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="colonydeposit-receipts"
S3_REGION="auto"
S3_PUBLIC_DOMAIN="https://cdn.colonydeposit.example.com"

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & MONITORING (Sentry)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="1.0"

# ------------------------------------------------------------------------------
# 7. PUBLIC FRONTEND & API URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

