# ==============================================================================
# ColonyDeposit - STAGING ENVIRONMENT CONFIGURATION (.env.staging)
# ==============================================================================

# Application Environment
NODE_ENV=staging
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_URL=https://staging-deposit.yourcolony.org
ADDITIONAL_ALLOWED_ORIGINS=https://staging-deposit.yourcolony.org

# Database Configuration (Staging Managed PostgreSQL + Connection Pool)
DATABASE_URL="postgresql://colony_staging:StagingSecurePass123!@postgres.staging.internal:5432/colony_deposit_staging?schema=public&connection_limit=15&pool_timeout=10"

# Redis Cache & Queues (Staging Redis)
REDIS_URL="redis://:StagingRedisToken!@redis.staging.internal:6379"

# Security & Cryptography
JWT_SECRET="staging-jwt-access-and-refresh-secret-min-32-chars-long!"
ENCRYPTION_KEY="staging-field-level-aes-256-gcm-secret-key-32-bytes!"

# Payment Gateway (Razorpay TEST Mode)
RAZORPAY_TEST_MODE=true
RAZORPAY_KEY_ID="rzp_test_StagingKey101"
RAZORPAY_KEY_SECRET="staging_secret_key_mock_123"
RAZORPAY_WEBHOOK_SECRET="staging_webhook_secret_hmac_sha256"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_StagingKey101"

# SMS OTP Provider (Swappable: MSG91, TWILIO, or CONSOLE)
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY="staging_msg91_auth_key"
MSG91_TEMPLATE_ID="staging_otp_template_id"
MSG91_SENDER_ID="COLDEP"

# Email Provider (RESEND, SENDGRID, or CONSOLE)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY="re_staging_test_token"
EMAIL_FROM="Colony Admin Staging <staging-noreply@yourcolony.org>"

# Object Storage for PDF Receipts (Cloudflare R2 Staging Bucket)
S3_ENDPOINT="https://<staging_account_id>.r2.cloudflarestorage.com"
S3_BUCKET="colony-deposit-staging-receipts"
S3_ACCESS_KEY_ID="staging_r2_access_key"
S3_SECRET_ACCESS_KEY="staging_r2_secret_key"
S3_PUBLIC_DOMAIN="https://staging-receipts.yourcolony.org"

# Observability, Monitoring & Alerts
SENTRY_DSN="https://staging_sentry_public_key@o000000.ingest.sentry.io/staging_project"
OPS_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/stagingOpsAlerts"

