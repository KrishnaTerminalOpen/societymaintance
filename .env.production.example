# ==============================================================================
# ColonyDeposit - PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_URL=https://deposit.yourcolony.org
ADDITIONAL_ALLOWED_ORIGINS=https://deposit.yourcolony.org

# Database Configuration (Production Managed PostgreSQL + PgBouncer Pooler)
# Note: Ensure sslmode=require and appropriate connection_limit in production
DATABASE_URL="postgresql://colony_prod_user:GenerateStrongPasswordHere@prod-db.yourcolony.internal:6543/colony_deposit_production?schema=public&sslmode=require&connection_limit=25&pool_timeout=15"

# Redis Cache & BullMQ Queues (Production Managed Redis with TLS & Password)
REDIS_URL="rediss://default:StrongProductionRedisPassword@prod-redis.yourcolony.internal:6380"

# Cryptographic Keys (MUST BE CRITICAL SECRETS ROTATED REGULARLY)
JWT_SECRET="MUST_BE_AT_LEAST_64_RANDOM_HIGH_ENTROPY_HEX_CHARACTERS_FOR_PROD"
ENCRYPTION_KEY="MUST_BE_32_BYTE_HEX_KEY_FOR_AES_256_GCM_DATABASE_ENCRYPTION"

# Payment Gateway (Razorpay LIVE Mode)
RAZORPAY_TEST_MODE=false
RAZORPAY_KEY_ID="rzp_live_ProductionKeyActual"
RAZORPAY_KEY_SECRET="ActualProductionRazorpaySecretKey"
RAZORPAY_WEBHOOK_SECRET="ActualProductionRazorpayWebhookSecret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_ProductionKeyActual"

# SMS OTP Provider (Swappable: MSG91, TWILIO)
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY="prod_msg91_live_auth_key"
MSG91_TEMPLATE_ID="prod_otp_dlt_approved_template_id"
MSG91_SENDER_ID="COLONY"

# Email Provider (RESEND or SENDGRID)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY="re_live_production_key"
EMAIL_FROM="Colony RWA Management <deposits@yourcolony.org>"

# Optional WhatsApp Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID="prod_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="prod_whatsapp_system_user_token"

# Object Storage for PDF Receipts (Cloudflare R2 Production Bucket)
S3_ENDPOINT="https://<cloudflare_account_id>.r2.cloudflarestorage.com"
S3_BUCKET="colony-deposit-receipts-prod"
S3_ACCESS_KEY_ID="prod_r2_token_access_key"
S3_SECRET_ACCESS_KEY="prod_r2_token_secret_key"
S3_PUBLIC_DOMAIN="https://receipts.yourcolony.org"

# Observability, Monitoring & Sentry Error Tracking
SENTRY_DSN="https://prod_sentry_key@o000000.ingest.sentry.io/colony_deposit_prod"
NEXT_PUBLIC_SENTRY_DSN="https://prod_sentry_key@o000000.ingest.sentry.io/colony_deposit_prod"
OPS_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/prodPaymentFailureAlerts"

